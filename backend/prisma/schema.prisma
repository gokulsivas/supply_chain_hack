// backend/prisma/schema.prisma
// Supply Chain Control Tower — E2 (Yard/Dock/Delivery Tracker) + PR2 (Autonomous P2P)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  PROCUREMENT_USER
  LOGISTICS_USER
  FINANCE_USER
  WAREHOUSE_OPERATOR
}

enum PRStatus {
  PENDING
  VALIDATED
  APPROVED
  REJECTED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum POStatus {
  DRAFT
  ISSUED
  IN_TRANSIT
  RECEIVED
  CLOSED
  CANCELLED
}

enum ShipmentStatus {
  CREATED
  DISPATCHED
  IN_TRANSIT
  ARRIVED_AT_YARD
  DOCKED
  UNLOADING
  COMPLETED
}

enum TruckStatus {
  ASSIGNED
  IN_TRANSIT
  DELAYED
  ARRIVED
  DOCKED
  DEPARTED
}

enum DockStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum GRStatus {
  PENDING
  SCANNING
  RECEIVED
  PARTIAL
  DISCREPANCY
}

enum InvoiceStatus {
  UPLOADED
  OCR_PROCESSING
  OCR_EXTRACTED
  VALIDATED
  FLAGGED
  APPROVED
  REJECTED
}

enum MatchStatus {
  PENDING
  MATCHED
  MISMATCHED
  OVERRIDDEN
}

enum PaymentStatus {
  PENDING
  APPROVED
  BLOCKED
  PAID
  FAILED
}

enum AlertType {
  DELAY
  DOCK_UNAVAILABLE
  REASSIGNMENT_NEEDED
  ANOMALY
  MATCH_FAILED
  LOW_STOCK
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// ─────────────────────────────────────────────
// CORE ENTITIES
// ─────────────────────────────────────────────

model User {
  id                String            @id @default(uuid())
  name              String
  email             String            @unique
  passwordHash      String
  role              Role              @default(PROCUREMENT_USER)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  purchaseRequests  PurchaseRequest[]
  goodsReceipts     GoodsReceipt[]
  payments          Payment[]
}

model Supplier {
  id                String            @id @default(uuid())
  name              String
  contactEmail      String?
  contactPhone      String?
  pricingScore      Float             @default(0)
  qualityScore      Float             @default(0)
  deliveryScore      Float            @default(0)
  capacityScore     Float             @default(0)
  leadTimeScore     Float             @default(0)
  overallScore      Float             @default(0)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())

  purchaseOrders    PurchaseOrder[]
  products          Product[]
}

model Product {
  id                String            @id @default(uuid())
  name              String
  sku               String            @unique
  unit              String            @default("unit")
  unitPrice         Float
  supplierId        String?
  supplier          Supplier?         @relation(fields: [supplierId], references: [id])

  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
}

// ─────────────────────────────────────────────
// PR2: REQUISITION (AI Chatbot → Purchase Request)
// ─────────────────────────────────────────────

model PurchaseRequest {
  id                String            @id @default(uuid())
  requestCode       String            @unique   // e.g. REQ001
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  deliveryLocation  String
  requiredDate      DateTime
  priority          Priority          @default(NORMAL)
  status            PRStatus          @default(PENDING)
  rawChatInput      String?           // original NLP chatbot message
  extractedJson     Json?             // structured entities extracted by Gemini
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items             PurchaseRequestItem[]
  purchaseOrder     PurchaseOrder?
}

model PurchaseRequestItem {
  id                String            @id @default(uuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest   @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  productId         String
  product           Product           @relation(fields: [productId], references: [id])
  quantity          Int
}

// ─────────────────────────────────────────────
// PR2: SOURCING & PO (AI Supplier Selection)
// ─────────────────────────────────────────────

model PurchaseOrder {
  id                String            @id @default(uuid())
  poCode            String            @unique   // e.g. PO-001
  purchaseRequestId String            @unique
  purchaseRequest   PurchaseRequest   @relation(fields: [purchaseRequestId], references: [id])
  supplierId        String
  supplier          Supplier          @relation(fields: [supplierId], references: [id])
  totalAmount       Float
  status            POStatus          @default(DRAFT)
  expectedDeliveryDate DateTime
  recommendationScore  Float?         // AI supplier score at time of selection
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items             PurchaseOrderItem[]
  shipment          Shipment?
  goodsReceipt      GoodsReceipt?
  invoice           Invoice?
}

model PurchaseOrderItem {
  id                String            @id @default(uuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product           @relation(fields: [productId], references: [id])
  quantity          Int
  unitPrice         Float
  lineTotal         Float
}

// ─────────────────────────────────────────────
// E2: SHIPMENT / TRUCK / YARD / DOCK
// ─────────────────────────────────────────────

model Shipment {
  id                String            @id @default(uuid())
  shipmentCode      String            @unique   // e.g. SHP001
  trackingNumber    String            @unique   // customer/ops lookup key (E2 requirement)
  purchaseOrderId   String            @unique
  purchaseOrder     PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  status            ShipmentStatus    @default(CREATED)
  originLocation    String
  destinationLocation String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  truck             Truck?
}

model Truck {
  id                String            @id @default(uuid())
  truckCode         String            @unique   // e.g. TRK001
  trailerId         String            @unique   // E2: lookup by trailer ID
  shipmentId        String            @unique
  shipment          Shipment          @relation(fields: [shipmentId], references: [id])
  status            TruckStatus       @default(ASSIGNED)
  currentLat        Float?
  currentLng        Float?
  progressPercent    Int              @default(0)
  originalEta       DateTime?
  currentEta        DateTime?
  delayMinutes      Int               @default(0)
  loadType          String?           // used for dock recommendation
  priority          Priority          @default(NORMAL)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  dockAssignment    DockAssignment?
  alerts            Alert[]
}

model Dock {
  id                String            @id @default(uuid())
  dockCode          String            @unique   // e.g. Dock 1
  status            DockStatus        @default(AVAILABLE)
  suitableLoadTypes String[]          @default([])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  assignments       DockAssignment[]
}

model DockAssignment {
  id                String            @id @default(uuid())
  truckId           String            @unique
  truck             Truck             @relation(fields: [truckId], references: [id])
  dockId            String
  dock              Dock              @relation(fields: [dockId], references: [id])
  recommendedScore  Float?            // AI recommendation score
  assignedAt        DateTime          @default(now())
  departedAt        DateTime?
}

// ─────────────────────────────────────────────
// PR2: RECEIVING (Simulated CV/IoT Goods Receipt)
// ─────────────────────────────────────────────

model GoodsReceipt {
  id                String            @id @default(uuid())
  grCode            String            @unique   // e.g. GR-001
  purchaseOrderId   String            @unique
  purchaseOrder     PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  quantityExpected  Int
  quantityReceived  Int
  status            GRStatus          @default(PENDING)
  cvScanConfirmed   Boolean           @default(false)   // simulated computer-vision check
  cvScanData        Json?             // simulated detected labels/counts/confidence
  cvConfidence      Float?
  receivedAt        DateTime?
  createdAt         DateTime          @default(now())

  threeWayMatch     ThreeWayMatch?
}

// ─────────────────────────────────────────────
// PR2: INVOICING (OCR + 3-Way Match + Anomaly Detection)
// ─────────────────────────────────────────────

model Invoice {
  id                String            @id @default(uuid())
  invoiceCode       String            @unique   // e.g. INV001
  purchaseOrderId   String            @unique
  purchaseOrder     PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  fileUrl           String            // stored path from Multer upload
  ocrRawText        String?
  extractedInvoiceNumber String?
  extractedSupplier String?
  extractedQuantity Int?
  extractedAmount   Float?
  status            InvoiceStatus     @default(UPLOADED)
  isAnomaly         Boolean           @default(false)   // predictive anomaly detection
  anomalyReason     String?
  anomalyScore      Float?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  threeWayMatch     ThreeWayMatch?
}

model ThreeWayMatch {
  id                String            @id @default(uuid())
  goodsReceiptId    String            @unique
  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id])
  invoiceId         String            @unique
  invoice           Invoice           @relation(fields: [invoiceId], references: [id])
  poQuantity        Int
  receivedQuantity  Int
  invoicedQuantity  Int
  poAmount          Float
  invoicedAmount    Float
  status            MatchStatus       @default(PENDING)
  mismatchDetails   Json?
  matchedAt         DateTime?

  payment           Payment?
}

model Payment {
  id                String            @id @default(uuid())
  paymentCode       String            @unique
  threeWayMatchId   String            @unique
  threeWayMatch     ThreeWayMatch     @relation(fields: [threeWayMatchId], references: [id])
  approvedByUserId  String?
  approvedBy        User?             @relation(fields: [approvedByUserId], references: [id])
  amount            Float
  status            PaymentStatus     @default(PENDING)
  approvedAt        DateTime?
  paidAt            DateTime?
  createdAt         DateTime          @default(now())
}

// ─────────────────────────────────────────────
// CROSS-CUTTING: ALERTS (E2 delays/docks + PR2 anomalies)
// ─────────────────────────────────────────────

model Alert {
  id                String            @id @default(uuid())
  type              AlertType
  severity          AlertSeverity     @default(WARNING)
  message           String
  truckId           String?
  truck             Truck?            @relation(fields: [truckId], references: [id])
  isResolved        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  resolvedAt        DateTime?
}
